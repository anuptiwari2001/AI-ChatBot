# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- optional tuning (defaults shown) ---
# Fast + cheap. For harder questions use openai/gpt-oss-120b
# (llama-3.1-8b-instant / llama-3.3-70b-versatile were retired on 2026-08-16)
GROQ_MODEL=openai/gpt-oss-20b
# gpt-oss reasoning depth: low (fastest) | medium | high
REASONING_EFFORT=low
TEMPERATURE=0.6
MAX_TOKENS=2048
MAX_HISTORY=20
# Comma-separated list in production, e.g. https://myapp.com
CORS_ORIGINS=*

